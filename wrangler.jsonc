{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "python-react-2",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-16",
  "upload_source_maps": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  }
}
